# Public Albatross RPC used to confirm NIM payments. Defaults to Nimiq Watch.
NIMIQ_RPC=https://rpc.nimiqwatch.com

# Nimiq address that receives bounty prize funds. Required for live bounties.
ESCROW_ADDRESS=

# Set to 1 to allow Alice/Bob demo wallets when the app is not inside Nimiq Pay.
DEMO_PAYMENTS=1

# GitBook handbook. Leave empty until the space is published.
NEXT_PUBLIC_DOCS_URL=

# Support mailbox. Leave empty until you have one.
NEXT_PUBLIC_SUPPORT_EMAIL=
